# ─── Database ───────────────────────────────
DATABASE_URL="postgresql://workreport:workreport@localhost:5432/workreport?schema=public"

# ─── Auth ───────────────────────────────────
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ─── Redis / Queue ──────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Object Storage (S3 호환 / MinIO for local dev) ─
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="workreport"
S3_SECRET_KEY="workreport123"
S3_BUCKET="workreport-attachments"

# ─── LLM (구조화 / Context AI) ───────────────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ─── API ────────────────────────────────────
API_PORT=4000
API_URL="http://localhost:4000"

# ─── Web ────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ─── File storage ───────────────────────────
# local: API 서버 디스크에 저장(기본) / s3: 아래 S3_* 사용
STORAGE_DRIVER="local"
# UPLOAD_DIR="./uploads"
